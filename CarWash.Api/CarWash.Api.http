@host = http://localhost:5000
@carId = 1
@customerId = 1
@serviceId = 1
@orderId = 1

### Выполняй запросы по одному сверху вниз на пустом сервере.
### Если ID в ответах отличаются, замени переменные выше.
### Создать автомобиль
POST {{host}}/api/cars
Content-Type: application/json

{
  "licensePlate": "A001AA",
  "brand": "Toyota"
}

### Создать клиента
POST {{host}}/api/customers
Content-Type: application/json

{
  "fullName": "Иванов Иван Иванович",
  "phone": "79000000001",
  "carIds": [{{carId}}]
}

### Создать услугу
POST {{host}}/api/wash-services
Content-Type: application/json

{
  "name": "Стандартная мойка",
  "category": "Sedan",
  "cost": 500,
  "durationMinutes": 30
}

### Создать текущий заказ
POST {{host}}/api/orders
Content-Type: application/json

{
  "customerId": {{customerId}},
  "carId": {{carId}},
  "washServiceId": {{serviceId}},
  "startTime": "{{$datetime iso8601}}",
  "boxNumber": 1
}

### Все автомобили
GET {{host}}/api/cars

### Автомобиль по ID
GET {{host}}/api/cars/{{carId}}

### Все клиенты
GET {{host}}/api/customers

### Клиент по ID
GET {{host}}/api/customers/{{customerId}}

### Все услуги
GET {{host}}/api/wash-services

### Услуга по ID
GET {{host}}/api/wash-services/{{serviceId}}

### Все заказы
GET {{host}}/api/orders

### Заказ по ID
GET {{host}}/api/orders/{{orderId}}

### Пять клиентов с наибольшим количеством посещений
GET {{host}}/api/analytics/top-customers

### Автомобили на мойке сейчас
GET {{host}}/api/analytics/current-cars

### Пять наиболее популярных услуг
GET {{host}}/api/analytics/top-services

### Время освобождения первого бокса
GET {{host}}/api/analytics/boxes/1/available-from

### Выручка по каждой услуге
GET {{host}}/api/analytics/revenue-per-service

### Изменить автомобиль
PUT {{host}}/api/cars/{{carId}}
Content-Type: application/json

{
  "licensePlate": "A111AA",
  "brand": "Toyota Camry"
}

### Изменить клиента
PUT {{host}}/api/customers/{{customerId}}
Content-Type: application/json

{
  "fullName": "Иванов Иван Иванович",
  "phone": "79000000002",
  "carIds": [{{carId}}]
}

### Изменить услугу
PUT {{host}}/api/wash-services/{{serviceId}}
Content-Type: application/json

{
  "name": "Стандартная мойка",
  "category": "Sedan",
  "cost": 600,
  "durationMinutes": 35
}

### Изменить заказ
PUT {{host}}/api/orders/{{orderId}}
Content-Type: application/json

{
  "customerId": {{customerId}},
  "carId": {{carId}},
  "washServiceId": {{serviceId}},
  "startTime": "{{$datetime iso8601}}",
  "boxNumber": 2
}

### Удаление: сначала заказ, затем остальные сущности
DELETE {{host}}/api/orders/{{orderId}}

### Удалить клиента
DELETE {{host}}/api/customers/{{customerId}}

### Удалить автомобиль
DELETE {{host}}/api/cars/{{carId}}

### Удалить услугу
DELETE {{host}}/api/wash-services/{{serviceId}}
